// The site on Cloudflare Workers: static assets only (out/, Next's static export), no
// code of its own. Served on workers.dev and on cellular.computer and its www, both
// Workers custom domains (listed here so every deploy keeps them).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cells-site",
  "account_id": "117aeda5f6c68507fb61620b7f26852c",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "cellular.computer", "custom_domain": true },
    { "pattern": "www.cellular.computer", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
