    { "name": "dear", "type": "yes/no", "formula": "cost >= 80 and qty is not null" },
    { "name": "rounded", "type": "EUR", "formula": "round(cost / 3, 2)" },
    { "name": "loud", "type": "text", "formula": "upper(item)" }
  ],
