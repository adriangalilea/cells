{
  "columns": [
    { "name": "item", "type": "text" },
    { "name": "cost", "type": "EUR" },
    { "name": "qty", "type": "int?" },
    { "name": "size", "type": "text", "formula": "case when cost > 50 then 'big' else 'small' end" },
