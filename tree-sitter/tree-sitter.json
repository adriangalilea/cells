{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cells",
      "camelcase": "Cells",
      "title": "Cells",
      "scope": "source.cells",
      "path": ".",
      "file-types": ["cells"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^cells$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Cells: records, typed header cells and their formulas, cells holding their own, and the prelude with its imports, tables and fences",
    "authors": [{ "name": "Adrian Galilea" }],
    "links": { "repository": "https://github.com/adriangalilea/cells" }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
