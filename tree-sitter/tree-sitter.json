{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tcsv",
      "camelcase": "TCSV",
      "title": "TCSV",
      "scope": "source.tcsv",
      "path": ".",
      "file-types": ["tcsv"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^tcsv$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "TCSV, typed CSV: records, typed header cells and the prelude",
    "authors": [{ "name": "Adrian Galilea", "email": "adriangalilea@gmail.com" }],
    "links": { "repository": "https://github.com/adriangalilea/tcsv" }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
