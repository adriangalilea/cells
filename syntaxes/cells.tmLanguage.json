{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cells",
  "displayName": "Cells",
  "scopeName": "source.cells",
  "fileTypes": [
    "cells"
  ],
  "comment": "GENERATED by syntaxes/build.ts. Cells, data and its logic in one plain-text file: see SPEC.md.",
  "patterns": [
    {
      "comment": "A file that opens with a prelude: the prelude, then the body.",
      "begin": "\\A(?=---[ \\t]*$)",
      "end": "(?!)",
      "patterns": [
        {
          "begin": "\\A(---)[ \\t]*$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.prelude.cells"
            }
          },
          "end": "^(---)[ \\t]*$",
          "endCaptures": {
            "1": {
              "name": "punctuation.separator.prelude.cells"
            }
          },
          "contentName": "meta.embedded.block.prelude.cells",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "comment": "An import: a table by default, or what the other file exports, from a path or a pinned URL.",
              "match": "^[ \\t]*(import)[ \\t]+(?:([A-Za-z_][A-Za-z0-9_]*)|(\\{[^}]*\\}))[ \\t]+(from)[ \\t]+(\"[^\"\\r\\n]*\")(?:[ \\t]+(with)[ \\t]+(\\{[^}]*\\}))?",
              "captures": {
                "1": {
                  "name": "keyword.control.import.cells"
                },
                "2": {
                  "name": "entity.name.namespace.cells"
                },
                "3": {
                  "patterns": [
                    {
                      "match": "[{}]",
                      "name": "punctuation.section.braces.cells"
                    },
                    {
                      "match": ",",
                      "name": "punctuation.separator.comma.cells"
                    },
                    {
                      "match": "[A-Za-z_][A-Za-z0-9_]*",
                      "name": "entity.name.namespace.cells"
                    }
                  ]
                },
                "4": {
                  "name": "keyword.control.import.cells"
                },
                "5": {
                  "name": "string.quoted.double.path.cells"
                },
                "6": {
                  "name": "keyword.control.import.cells"
                },
                "7": {
                  "patterns": [
                    {
                      "match": "[{}]",
                      "name": "punctuation.section.braces.cells"
                    },
                    {
                      "match": ",",
                      "name": "punctuation.separator.comma.cells"
                    },
                    {
                      "match": "([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(:)",
                      "captures": {
                        "1": {
                          "name": "entity.other.attribute-name.import.cells"
                        },
                        "2": {
                          "name": "punctuation.separator.type.cells"
                        }
                      }
                    },
                    {
                      "match": "\"[^\"\\r\\n]*\"",
                      "name": "string.quoted.double.path.cells"
                    }
                  ]
                }
              }
            },
            {
              "match": "^[ \\t]*(?:(export)[ \\t]+)?(type)[ \\t]+([A-Z][A-Za-z0-9_]*)[ \\t]*(=)[ \\t]*((?:[^/\\r\\n]|/(?!/))*)",
              "captures": {
                "1": {
                  "name": "storage.modifier.export.cells"
                },
                "2": {
                  "name": "storage.type.cells"
                },
                "3": {
                  "name": "entity.name.type.cells"
                },
                "4": {
                  "name": "keyword.operator.assignment.cells"
                },
                "5": {
                  "name": "meta.type.cells",
                  "patterns": [
                    {
                      "include": "#type"
                    }
                  ]
                }
              }
            },
            {
              "comment": "A table a script fills: its name, `run` and the schedule; its fences follow.",
              "match": "^[ \\t]*(?:(export)[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(=)[ \\t]*(run)\\b((?:[^/\\r\\n]|/(?!/))*)",
              "captures": {
                "1": {
                  "name": "storage.modifier.export.cells"
                },
                "2": {
                  "name": "entity.name.function.table.cells"
                },
                "3": {
                  "name": "keyword.operator.assignment.cells"
                },
                "4": {
                  "name": "keyword.control.run.cells"
                },
                "5": {
                  "patterns": [
                    {
                      "match": "\\b(?:every|at|on|in|cron|when|changes)\\b",
                      "name": "keyword.other.schedule.cells"
                    },
                    {
                      "match": "\\b\\d{1,2}:\\d{2}\\b",
                      "name": "constant.numeric.cells"
                    },
                    {
                      "match": ",",
                      "name": "punctuation.separator.comma.cells"
                    },
                    {
                      "match": "[^\\s,]+",
                      "name": "string.unquoted.schedule.cells"
                    }
                  ]
                }
              }
            },
            {
              "comment": "A table written inline: its name, then its fence on the same line.",
              "match": "^[ \\t]*(?:(export)[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(=)(?=[ \\t]*\\x60{3,})",
              "captures": {
                "1": {
                  "name": "storage.modifier.export.cells"
                },
                "2": {
                  "name": "entity.name.function.table.cells"
                },
                "3": {
                  "name": "keyword.operator.assignment.cells"
                }
              }
            },
            {
              "comment": "How a value looks: `look`, what it is for (the row, a named type, a column), then its rules.",
              "match": "^[ \\t]*(look)[ \\t]+(?:(row)|([A-Z][A-Za-z0-9_]*)|(\"(?:[^\"]|\"\")*\"|[^:\\r\\n]*?))[ \\t]*(:)((?:[^/\\r\\n]|/(?!/))*)",
              "captures": {
                "1": {
                  "name": "keyword.other.look.cells"
                },
                "2": {
                  "name": "variable.language.cells"
                },
                "3": {
                  "name": "entity.name.type.cells"
                },
                "4": {
                  "name": "variable.other.member.column.declared.cells"
                },
                "5": {
                  "name": "punctuation.separator.type.cells"
                },
                "6": {
                  "patterns": [
                    {
                      "include": "#look"
                    }
                  ]
                }
              }
            },
            {
              "comment": "A column's declaration: its name (quoted when it holds a `:`, a `,` or a `\"`), then its type and its formula as a header cell's after its `:`.",
              "match": "^[ \\t]*(\"(?:[^\"]|\"\")*\"|[^:=,\"\\r\\n/ \\t][^:=,\"\\r\\n/]*?)[ \\t]*(:)((?:[^/\\r\\n]|/(?!/))*)",
              "captures": {
                "1": {
                  "name": "variable.other.member.column.declared.cells"
                },
                "2": {
                  "name": "punctuation.separator.type.cells"
                },
                "3": {
                  "name": "meta.type.cells",
                  "patterns": [
                    {
                      "include": "#type"
                    }
                  ]
                }
              }
            },
            {
              "begin": "(\\x60{3,})(ts)[ \\t]*$",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.fence.cells"
                },
                "2": {
                  "name": "entity.name.section.language.cells"
                },
                "3": {
                  "name": "entity.other.attribute-name.fence.cells"
                }
              },
              "end": "^(\\1)[ \\t]*$",
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.fence.cells"
                }
              },
              "contentName": "meta.embedded.block.typescript",
              "patterns": [
                {
                  "include": "source.ts"
                }
              ]
            },
            {
              "begin": "(\\x60{3,})(cells)(?:[ \\t]+(runs))?[ \\t]*$",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.fence.cells"
                },
                "2": {
                  "name": "entity.name.section.language.cells"
                },
                "3": {
                  "name": "entity.other.attribute-name.fence.cells"
                }
              },
              "end": "^(\\1)[ \\t]*$",
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.fence.cells"
                }
              },
              "contentName": "meta.embedded.block.cells",
              "patterns": [
                {
                  "comment": "The table: its header, then its rows, up to the closing fence.",
                  "begin": "^(?=[^\\r\\n])",
                  "end": "^(?=\\x60{3,}[ \\t]*$)",
                  "patterns": [
                    {
                      "begin": "\\G",
                      "end": "$",
                      "name": "meta.header.cells",
                      "patterns": [
                        {
                          "include": "#header"
                        }
                      ]
                    },
                    {
                      "include": "#row"
                    }
                  ]
                }
              ]
            },
            {
              "begin": "(\\x60{3,})([A-Za-z0-9_+-]*)[ \\t]*$",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.fence.cells"
                },
                "2": {
                  "name": "entity.name.section.language.cells"
                },
                "3": {
                  "name": "entity.other.attribute-name.fence.cells"
                }
              },
              "end": "^(\\1)[ \\t]*$",
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.fence.cells"
                }
              },
              "contentName": "meta.embedded.block",
              "patterns": []
            }
          ]
        },
        {
          "comment": "The header, then every row: never ends.",
          "begin": "^(?=[^\\r\\n])",
          "end": "(?!)",
          "patterns": [
            {
              "comment": "The header is the body's first line.",
              "begin": "\\G",
              "end": "$",
              "name": "meta.header.cells",
              "patterns": [
                {
                  "include": "#header"
                }
              ]
            },
            {
              "comment": "A quoted field that holds a line break: a string until its closing quote.",
              "begin": "(?:^|(,))[ \\t]*(\")(?=(?:[^\"]|\"\")*$)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.separator.comma.cells"
                },
                "2": {
                  "name": "punctuation.definition.string.begin.cells"
                }
              },
              "end": "(\")(?!\")",
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.string.end.cells"
                }
              },
              "name": "string.quoted.double.cells",
              "patterns": [
                {
                  "match": "\"\"",
                  "name": "constant.character.escape.cells"
                }
              ]
            },
            {
              "include": "#row"
            }
          ]
        }
      ]
    },
    {
      "comment": "The header, then every row: never ends.",
      "begin": "^(?=[^\\r\\n])",
      "end": "(?!)",
      "patterns": [
        {
          "comment": "The header is the body's first line.",
          "begin": "\\G",
          "end": "$",
          "name": "meta.header.cells",
          "patterns": [
            {
              "include": "#header"
            }
          ]
        },
        {
          "comment": "A quoted field that holds a line break: a string until its closing quote.",
          "begin": "(?:^|(,))[ \\t]*(\")(?=(?:[^\"]|\"\")*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.comma.cells"
            },
            "2": {
              "name": "punctuation.definition.string.begin.cells"
            }
          },
          "end": "(\")(?!\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.cells"
            }
          },
          "name": "string.quoted.double.cells",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.cells"
            }
          ]
        },
        {
          "include": "#row"
        }
      ]
    }
  ],
  "repository": {
